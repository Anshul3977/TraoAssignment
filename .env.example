# Copy to `.env` for local development. Never commit real secrets.

# Which LLM provider to try first: "gemini" | "groq"
LLM_PROVIDER=gemini

# Google Gemini (free tier). Used when LLM_PROVIDER=gemini or as fallback.
GEMINI_API_KEY=
# Model id — free-tier daily caps are per-model; gemini-flash-lite-latest is a durable default
GEMINI_MODEL=gemini-flash-lite-latest

# Groq (OpenAI-compatible free tier). Used when LLM_PROVIDER=groq or as fallback.
GROQ_API_KEY=
# Model id, e.g. llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/prep-kit

# Secret for signing session JWTs (use a long random string in production)
JWT_SECRET=change-me-in-production

# Allow fetches to private/loopback hosts (needed for local fixtures).
# In production, leave unset/false unless you intentionally opt in.
ALLOW_PRIVATE_HOSTS=true

# Optional: Tavily or Brave search API key for discussion search
# SEARCH_API_KEY=

# Optional: directory for LLM response cache (dev only)
# LLM_CACHE_DIR=.llm-cache

# API origin for the Next.js `/api/*` rewrite (apps/web). Local default below.
# API_ORIGIN=http://localhost:4000
