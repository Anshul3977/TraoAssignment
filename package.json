{
  "name": "prep-kit",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "evaluate": "tsx packages/core/src/cli/evaluate.ts",
    "check-output": "tsx scripts/check-output.ts",
    "fixtures": "tsx scripts/serve-fixtures.ts",
    "clean-clone-check": "tsx scripts/clean-clone-check.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": "20.x"
  }
}
